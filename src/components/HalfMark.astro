---
/**
 * The ½ roundel. Inherits colour from `currentColor`; size via the `size` prop (any CSS length).
 * Decorative by default — the brand name is always present as text nearby.
 */
interface Props {
  size?: string;
  class?: string;
}
const { size = '3rem', class: className } = Astro.props;
---

<svg
  class:list={['half-mark', className]}
  viewBox="0 0 100 100"
  style={`width:${size};height:${size}`}
  aria-hidden="true"
  focusable="false"
>
  <circle cx="50" cy="50" r="47" fill="none" stroke="currentColor" stroke-width="3"></circle>
  <text x="35" y="49" text-anchor="middle">1</text>
  <line x1="31" y1="79" x2="69" y2="21" stroke="currentColor" stroke-width="4.5" stroke-linecap="square"></line>
  <text x="65" y="86" text-anchor="middle">2</text>
</svg>

<style>
  .half-mark {
    flex: none;
    overflow: visible;
  }
  text {
    fill: currentColor;
    font-family: var(--font-sign);
    font-stretch: 75%;
    font-weight: 750;
    font-size: 40px;
  }
</style>
