---
import HalfMark from './HalfMark.astro';
import { hours, site } from '../data/site';
import { summariseHours } from '../lib/hours';

const hourLines = summariseHours(hours).split(' · ');
---

<footer class="footer">
  <div class="container">
    <div class="footer__rule-wrap">
      <p class="footer__rule reveal" data-reveal>
        <span class="label footer__rule-num">Rule 09</span>
        Come back tomorrow. The decoction will be ready.
      </p>
    </div>

    <div class="footer__grid">
      <div class="footer__brand">
        <HalfMark size="3.5rem" />
        <p class="sign-type footer__name">One by Two</p>
        <p class="footer__desc">{site.descriptor} · {site.city}</p>
      </div>

      <div class="footer__col">
        <p class="label footer__h">Find us</p>
        <address>
          {site.address}
        </address>
        <a class="footer__link" href={site.mapsUrl} target="_blank" rel="noopener">
          Directions<span class="visually-hidden"> (opens Google Maps)</span>
        </a>
      </div>

      <div class="footer__col">
        <p class="label footer__h">Hours</p>
        <p>{hourLines.map((line) => <span class="footer__line">{line}</span>)}</p>
      </div>

      <div class="footer__col">
        <p class="label footer__h">Write, call, follow</p>
        <ul role="list">
          <li><a class="footer__link" href={site.phone.href}>{site.phone.display}</a></li>
          <li><a class="footer__link" href={`mailto:${site.email}`}>{site.email}</a></li>
          <li>
            <a class="footer__link" href={site.instagram.href} target="_blank" rel="noopener">
              Instagram {site.instagram.handle}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <p class="footer__small">
      © {new Date().getFullYear()} One by Two Coffee House. Some rules inherited, all coffee our own.
    </p>
  </div>
</footer>

<style>
  .footer {
    background: var(--ink);
    color: var(--cream);
    padding-block: var(--s-9) var(--s-6);
  }
  .footer__rule {
    display: grid;
    gap: var(--s-3);
    font-size: var(--step-4);
    line-height: 1.25;
    max-width: 30ch;
  }
  .footer__rule-wrap {
    padding-bottom: var(--s-8);
    border-bottom: var(--hairline) solid var(--cream-hair);
  }
  .footer__line {
    display: block;
  }
  .footer__rule-num {
    color: var(--vermilion-light);
  }
  .footer__grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: var(--s-7) var(--gap);
    padding-block: var(--s-8);
  }
  .footer__brand {
    display: grid;
    gap: var(--s-3);
    justify-items: start;
    color: var(--cream);
  }
  .footer__name {
    font-size: clamp(2.5rem, 5vw, 4rem);
  }
  .footer__desc {
    color: var(--cream-muted);
    font-family: var(--font-sign);
    font-weight: 600;
    letter-spacing: 0.04em;
  }
  .footer__col {
    display: grid;
    gap: var(--s-2);
    align-content: start;
    font-size: var(--step-0);
  }
  .footer__col address {
    font-style: normal;
  }
  .footer__h {
    color: var(--cream-muted);
    margin-bottom: var(--s-1);
  }
  .footer__col ul {
    list-style: none;
    padding: 0;
  }
  .footer__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
  }
  .footer__link:hover {
    text-decoration-thickness: 2px;
  }
  .footer__small {
    padding-top: var(--s-5);
    border-top: var(--hairline) solid var(--cream-hair);
    font-size: var(--step--1);
    color: var(--cream-muted);
  }

  @media (max-width: 1100px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 560px) {
    .footer__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
