---
// Fig. 4 — by two: one pour divided between two tumbler-and-davara sets.
const sets = [64, 176];
---
<svg viewBox="0 0 240 240" role="img" aria-labelledby="fig4-t">
  <title id="fig4-t">One pour of coffee divided into two tumblers, each standing in its davara</title>
  <path class="stream stream--thin" pathLength="1" d="M120 18 V52 M120 52 Q120 66 64 92 M120 52 Q120 66 176 92" />
  <g class="liquid">
    <path d="M59 86 L66 96 L69 84 Z" />
    <path d="M181 86 L174 96 L171 84 Z" />
  </g>
  {
    sets.map((c) => (
      <g>
        <g class="ln">
          <rect pathLength="1" x={c - 22} y="108" width="44" height="4" />
          <path pathLength="1" d={`M${c - 16.8} 180 L${c - 20} 112 H${c + 20} L${c + 16.8} 180`} />
          <path pathLength="1" d={`M${c - 19.6} 124 H${c + 19.6}`} />
          <rect pathLength="1" x={c - 44} y="176" width="88" height="4" />
          <path pathLength="1" d={`M${c - 40} 180 Q${c - 36} 202 ${c - 20} 204 H${c + 20} Q${c + 36} 202 ${c + 40} 180`} />
          <rect pathLength="1" x={c - 15} y="204" width="30" height="4" />
        </g>
        <path class="hid" d={`M${c - 16.8} 180 L${c - 16} 198 H${c + 16} L${c + 16.8} 180`} />
      </g>
    ))
  }
  <g class="anno" aria-hidden="true">
    <text x="128" y="26">One pour</text>
  </g>
  <g class="num" aria-hidden="true">
    <text x="64" y="232" text-anchor="middle">₹60</text>
    <text x="176" y="232" text-anchor="middle">₹60</text>
  </g>
</svg>
