---
// Fig. 2 — the filter in section: water above, grounds on the sieve, decoction collecting below. Dial: 11 of 12.
const grounds: { x: number; y: number }[] = [];
for (let row = 0; row < 3; row++) {
  for (let col = 0; col < 13; col++) grounds.push({ x: 90 + col * 5 + (row % 2) * 2.5, y: 140 + row * 4 });
}
const drops = [
  { x: 102, y: 164 },
  { x: 120, y: 174 },
  { x: 138, y: 160 },
];
---
<svg viewBox="0 0 240 240" role="img" aria-labelledby="fig2-t">
  <title id="fig2-t">Cut-away of the filter: decoction drips through the sieve into the lower chamber over eleven minutes</title>
  <g class="ln">
    <path pathLength="1" d="M86 54 V150" />
    <path pathLength="1" d="M154 54 V150" />
    <path pathLength="1" d="M80 120 H86 M154 120 H160" />
    <path pathLength="1" d="M78 125 V206 Q78 212 84 212 H156 Q162 212 162 206 V125" />
    <path pathLength="1" d="M88 72 q5.5 -3 11 0 t11 0 t11 0 t11 0 t11 0 t11 0" />
    <path pathLength="1" d="M90 134 Q120 122 150 134" />
    <path pathLength="1" d="M120 128 V68" />
    <circle pathLength="1" cx="120" cy="65" r="3" />
  </g>
  <path class="hid" d="M86 150 H154" />
  <g class="dots">
    {grounds.map((g) => <circle cx={g.x} cy={g.y} r="1" />)}
  </g>
  <g class="liquid">
    <path d="M79 188 H161 V206 Q161 211 156 211 H84 Q79 211 79 206 Z" />
    {drops.map((d) => <path transform={`translate(${d.x} ${d.y})`} d="M0 -5 C2 -2 3.2 0.6 3.2 2.2 A3.2 3.2 0 0 1 -3.2 2.2 C-3.2 0.6 -2 -2 0 -5 Z" />)}
    <path d="M200 60 L200 39 A21 21 0 1 1 189.5 41.8 Z" />
  </g>
  <g class="ln">
    <circle pathLength="1" cx="200" cy="60" r="25" />
  </g>
  <g class="anno" aria-hidden="true">
    <text x="200" y="102" text-anchor="middle">11 min</text>
    <path pathLength="1" d="M152 144 L184 138" /><text x="186" y="141">Grounds</text>
    <path pathLength="1" d="M150 198 L184 214" /><text x="186" y="217">Decoction</text>
    <path pathLength="1" d="M90 72 L52 62" /><text x="50" y="65" text-anchor="end">Water</text>
  </g>
</svg>
