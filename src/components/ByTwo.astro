---
import Filter from './figures/Filter.astro';
import Drip from './figures/Drip.astro';
import Pour from './figures/Pour.astro';
import Pair from './figures/Pair.astro';

const figures = [
  {
    Drawing: Filter,
    title: 'The filter',
    caption: 'Two steel chambers, a sieve and a press. The ground blend goes in the top, packed under the press.',
  },
  {
    Drawing: Drip,
    title: 'Eleven minutes',
    caption: 'Hot water on the grounds, then patience. A thick decoction collects below, a drop at a time.',
  },
  {
    Drawing: Pour,
    title: 'From a height',
    caption: 'Decoction meets boiled full-cream milk, poured tumbler to davara and back until it froths.',
  },
  {
    Drawing: Pair,
    title: 'By two',
    caption: 'Then divided at your table: two tumblers, two davaras, one bill. Sixty rupees a head.',
  },
];
---

<section class="ritual" id="by-two" aria-labelledby="by-two-title">
  <div class="container">
    <div class="ritual__intro">
      <div class="ritual__head">
        <p class="label ritual__eyebrow reveal" data-reveal>The house order</p>
        <h2 class="sign-type ritual__title mask-reveal" id="by-two-title" data-reveal><span class="mask__line"><span class="mask__inner">Kaapi, by&nbsp;two.</span></span></h2>
      </div>
      <div class="ritual__copy reveal" data-reveal style="--reveal-delay: 80ms">
        <p class="lede">
          Irani cafés have always split a chai between two glasses. We do the same with South Indian filter
          coffee: one decoction, poured at your table into two tumblers.
        </p>
        <p>
          Two cups for <strong class="price">₹120</strong>. Bring someone, or make a friend; the tables are small.
          With chicory, twenty percent, the old way, or without. Ask for it <em>strong</em> and we will know you
          grew up with it.
        </p>
      </div>
    </div>

    <ol class="plates" role="list">
      {
        figures.map(({ Drawing, title, caption }, i) => (
          <li class="plate reveal" data-reveal style={`--i: ${i}`}>
            <figure>
              <div class="plate__art drawing" data-reveal style={`--draw-delay: ${i * 120}ms`}>
                <Drawing />
              </div>
              <figcaption>
                <span class="label plate__num">Fig. {i + 1}</span>
                <span class="plate__title">{title}</span>
                <span class="plate__caption">{caption}</span>
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .ritual {
    padding-block: var(--section-y);
  }
  .ritual__intro {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--s-6) var(--gap);
    align-items: end;
  }
  .ritual__head {
    grid-column: 1 / span 5;
  }
  .ritual__eyebrow {
    color: var(--vermilion);
    margin-bottom: var(--s-4);
  }
  .ritual__title {
    font-size: var(--step-6);
    color: var(--ink);
  }
  .ritual__copy {
    grid-column: 7 / -1;
    display: grid;
    gap: var(--s-4);
    max-width: 58ch;
  }
  .price {
    font-family: var(--font-sign);
    font-weight: 650;
    letter-spacing: 0.01em;
    color: var(--enamel);
  }

  .plates {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--gap);
    margin-top: clamp(var(--s-8), 8vw, var(--s-9));
    padding: 0;
    list-style: none;
  }
  .plate figure {
    display: grid;
    gap: var(--s-4);
    border-top: 1.5px solid var(--ink);
    padding-top: var(--s-4);
  }
  .plate__art {
    aspect-ratio: 1;
  }
  .plate__art :global(svg) {
    width: 100%;
    height: 100%;
  }
  .plate figcaption {
    display: grid;
    gap: var(--s-1);
  }
  .plate__num {
    color: var(--vermilion);
  }
  .plate__title {
    font-family: var(--font-sign);
    font-stretch: 75%;
    font-weight: 750;
    font-size: var(--step-4);
    text-transform: uppercase;
    line-height: 1;
    margin-bottom: var(--s-2);
  }
  .plate__caption {
    font-size: var(--step-0);
    color: var(--ink-soft);
    max-width: 34ch;
  }

  @media (max-width: 1100px) {
    .ritual__head {
      grid-column: 1 / span 12;
    }
    .ritual__copy {
      grid-column: 1 / span 12;
    }
    .plates {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: var(--s-8);
    }
  }
  @media (max-width: 560px) {
    .plates {
      grid-template-columns: 1fr;
      row-gap: var(--s-7);
    }
    .plate__art {
      width: min(100%, 20rem);
      justify-self: center;
    }
  }
</style>
