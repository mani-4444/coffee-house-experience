---
import HalfMark from './HalfMark.astro';
import { board, pourOver } from '../data/menu';
---

<section class="board band-reveal" id="board" aria-labelledby="board-title" data-reveal>
  <div class="container">
    <header class="board__head">
      <div>
        <p class="label board__eyebrow reveal" data-reveal>Written up every morning</p>
        <h2 class="sign-type board__title mask-reveal" id="board-title" data-reveal>
          <span class="mask__line"><span class="mask__inner">The board</span></span>
        </h2>
      </div>
      <aside class="today reveal" aria-label="On the pour-over today" data-reveal="right" style="--i: 2">
        <p class="label today__label">On the pour-over today</p>
        <p class="today__origin">{pourOver.origin}</p>
        <p class="today__meta">{pourOver.process} · {pourOver.altitude}</p>
        <p class="today__notes">{pourOver.notes}</p>
      </aside>
    </header>

    <div class="board__cols">
      {
        board.map((section, i) => (
          <div class:list={['board__col', i === 0 ? 'board__col--lead' : 'board__col--side']}>
            <h3 class="board__section" id={`board-${section.id}`}>
              {section.title}
            </h3>
            <ul class="items" role="list">
              {section.items.map((item, k) => (
                <li
                  class:list={['item', 'reveal', item.signature && 'item--signature']}
                  id={`item-${item.id}`}
                  data-menu-item
                  data-reveal
                  style={`--i: ${k}`}
                >
                  <p class="item__line">
                    <span class="item__name">
                      {item.name}
                      {item.signature && (
                        <span class="item__mark">
                          <HalfMark size="1.15em" />
                          <span class="visually-hidden">(house order)</span>
                        </span>
                      )}
                    </span>
                    <span class="item__leader" aria-hidden="true" />
                    <span class="item__price">₹{item.price}</span>
                  </p>
                  <p class="item__note">
                    {item.note}
                    {item.byTwo && <span class="item__bytwo"> By two, ₹{item.byTwo}.</span>}
                  </p>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <p class="board__foot">Prices include GST. Water is free and refilled without asking.</p>
  </div>
</section>

<script>
  // Arriving from a drink card (or any link to a row): the row flashes crema once (D14).
  document.addEventListener('obt:arrive', (e) => {
    const row = e.target as HTMLElement;
    if (!row.matches('[data-menu-item]')) return;
    row.classList.remove('is-flash');
    void row.offsetWidth; // restart the animation on repeat visits
    row.classList.add('is-flash');
    window.setTimeout(() => row.classList.remove('is-flash'), 2400);
  });
</script>

<style>
  .board {
    background: var(--ink);
    color: var(--cream);
    padding-block: var(--section-y);
  }
  .board__head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: var(--s-7);
    flex-wrap: wrap;
    padding-bottom: var(--s-6);
    border-bottom: var(--rim-width) solid var(--cream);
  }
  .board__eyebrow {
    color: var(--crema);
    margin-bottom: var(--s-3);
  }
  .board__title {
    font-size: var(--step-6);
  }

  .today {
    display: grid;
    gap: var(--s-1);
    min-width: 16rem;
    padding: var(--s-4) var(--s-5);
    border: var(--hairline) solid var(--cream-hair);
  }
  .today__label {
    color: var(--cream-muted);
  }
  .today__origin {
    font-family: var(--font-sign);
    font-stretch: 75%;
    font-weight: 750;
    font-size: var(--step-4);
    text-transform: uppercase;
    line-height: 1.05;
  }
  .today__meta {
    font-family: var(--font-sign);
    font-weight: 600;
    font-size: var(--step-0);
    letter-spacing: 0.04em;
  }
  .today__notes {
    font-style: italic;
    color: var(--cream-muted);
  }

  /* Kaapi leads on the left; chai and the bakery case share the right column. */
  .board__cols {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    grid-template-rows: auto 1fr;
    gap: var(--s-7) clamp(var(--s-6), 6vw, var(--s-9));
    margin-top: var(--s-7);
  }
  .board__col--lead {
    grid-row: 1 / span 2;
  }
  .board__section {
    margin-inline: calc(var(--s-2) * -1);
    padding-inline: var(--s-2);
    font-family: var(--font-sign);
    font-stretch: 100%;
    font-weight: 650;
    font-size: var(--step--1);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--cream-muted);
    padding-bottom: var(--s-3);
    border-bottom: var(--hairline) solid var(--cream-hair);
  }
  .items {
    list-style: none;
    padding: 0;
  }
  .item {
    padding: var(--s-4) var(--s-2);
    margin-inline: calc(var(--s-2) * -1);
    border-bottom: var(--hairline) solid var(--cream-hair);
    transition: background-color var(--dur-quick) var(--ease-out);
  }
  .item:hover {
    background: var(--cream-wash);
  }
  .item__line {
    display: flex;
    align-items: baseline;
    gap: var(--s-2);
  }
  .item__name {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    font-family: var(--font-sign);
    font-stretch: 75%;
    font-weight: 700;
    font-size: 1.5rem;
    line-height: 1.1;
    text-transform: uppercase;
    letter-spacing: 0.01em;
  }
  .item__mark {
    display: inline-flex;
  }
  .item__leader {
    flex: 1;
    min-width: var(--s-4);
    border-bottom: 2px dotted var(--cream-hair);
    transform: translateY(-0.3em);
  }
  .item__price {
    font-family: var(--font-sign);
    font-stretch: 75%;
    font-weight: 700;
    font-size: 1.5rem;
    font-variant-numeric: tabular-nums lining-nums;
    transition: color var(--dur-quick) var(--ease-out);
  }
  .item:hover .item__price {
    color: var(--crema);
  }
  .item__note {
    margin-top: var(--s-1);
    font-size: var(--step-0);
    font-style: italic;
    color: var(--cream-muted);
    max-width: 40ch;
  }
  .item__bytwo {
    font-family: var(--font-sign);
    font-style: normal;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--cream);
  }
  .item--signature .item__name,
  .item--signature .item__price {
    font-size: 1.875rem;
  }

  .board__foot {
    margin-top: var(--s-7);
    font-size: var(--step-0);
    font-style: italic;
    color: var(--cream-muted);
  }

  @media (max-width: 860px) {
    .board__cols {
      grid-template-columns: 1fr;
    }
    .board__col--lead {
      grid-row: auto;
    }
  }
  @media (max-width: 760px) {
    .today {
      width: 100%;
    }
  }

  /* Arrival flash from a drink card. */
  .item.is-flash {
    animation: row-flash 2.2s var(--ease-out);
  }
  @keyframes row-flash {
    0%,
    35% {
      background: var(--crema-wash);
    }
    100% {
      background: transparent;
    }
  }
  /* Each row writes itself: the dotted leader draws left to right, then the price appears. */
  @media (prefers-reduced-motion: no-preference) {
    .item__leader {
      transform-origin: left;
      transition: transform 700ms var(--ease-out) calc(var(--i, 0) * var(--stagger) + 300ms);
    }
    .item__price {
      transition:
        opacity 400ms var(--ease-out) calc(var(--i, 0) * var(--stagger) + 800ms),
        color var(--dur-quick) var(--ease-out);
    }
    :global(.js) .item.reveal:not(.is-in) .item__leader {
      transform: translateY(-0.3em) scaleX(0);
    }
    :global(.js) .item.reveal:not(.is-in) .item__price {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .item.is-flash {
      animation: none;
      background: var(--crema-wash);
    }
  }
</style>
