---
// The opening animation (D11): coded, in the figure-plate line language (docs/art-direction.md).
// Three acts on one 240-unit plate, scaled up: the filter drips decoction → a pour from a height splits
// into two tumblers → the ½ mark. Every element is timed by --d (ms from the start) in Intro.astro.
const drops = [
  { x: 102, d: 950 },
  { x: 138, d: 1200 },
  { x: 120, d: 1450 },
];
const sets = [64, 176];
---

<svg class="anim" viewBox="16 0 208 222" aria-hidden="true" focusable="false">
  <!-- ACT 1: the filter, decoction dripping into the lower chamber -->
  <g class="act act--1">
    <g class="ln" style="--d: 0ms">
      <path pathLength="1" d="M113 42 V38 Q113 33 120 33 Q127 33 127 38 V42"></path>
      <path pathLength="1" d="M86 50 L92 42 H148 L154 50"></path>
      <path pathLength="1" d="M82 50 H158 V54 H82 Z"></path>
    </g>
    <g class="ln" style="--d: 150ms">
      <path pathLength="1" d="M86 54 V150 M154 54 V150"></path>
      <path pathLength="1" d="M80 120 H160 V125 H80 Z"></path>
    </g>
    <g class="ln" style="--d: 300ms">
      <path pathLength="1" d="M78 125 V206 Q78 212 84 212 H156 Q162 212 162 206 V125"></path>
      <path pathLength="1" d="M84 212 H156 V216 H84 Z"></path>
    </g>
    <path class="hid fade" style="--d: 700ms" d="M86 150 H154"></path>
    <path class="fill liquid" style="--d: 900ms; --dur: 1300ms" d="M79 176 H161 V206 Q161 211 156 211 H84 Q79 211 79 206 Z"></path>
    {
      drops.map((drop) => (
        // Position on the group, fall on the path: a CSS transform would replace an SVG transform attribute.
        <g transform={`translate(${drop.x} 156)`}>
          <path
            class="drop liquid"
            style={`--d: ${drop.d}ms`}
            d="M0 -5 C2 -2 3.2 0.6 3.2 2.2 A3.2 3.2 0 0 1 -3.2 2.2 C-3.2 0.6 -2 -2 0 -5 Z"
          />
        </g>
      ))
    }
  </g>

  <!-- ACT 2: one pour from a height, divided between two tumblers -->
  <g class="act act--2">
    <g class="ln" style="--d: 2250ms" transform="translate(186 4) rotate(-120)">
      <path pathLength="1" d="M-19 0 L-23 -70 H23 L19 0 Z"></path>
      <path pathLength="1" d="M-25 -74 H25 V-70 H-25 Z"></path>
    </g>
    {
      sets.map((c, i) => (
        <g>
          <g class="ln" style={`--d: ${2300 + i * 120}ms`}>
            <path pathLength="1" d={`M${c - 22} 108 H${c + 22} V112 H${c - 22} Z`} />
            <path pathLength="1" d={`M${c - 16.8} 180 L${c - 20} 112 H${c + 20} L${c + 16.8} 180`} />
            <path pathLength="1" d={`M${c - 44} 176 H${c + 44} V180 H${c - 44} Z`} />
            <path pathLength="1" d={`M${c - 40} 180 Q${c - 36} 202 ${c - 20} 204 H${c + 20} Q${c + 36} 202 ${c + 40} 180`} />
            <path pathLength="1" d={`M${c - 15} 204 H${c + 15} V208 H${c - 15} Z`} />
          </g>
          <path
            class="fill liquid"
            style={`--d: ${3500 + i * 90}ms; --dur: 750ms`}
            d={`M${c - 16.8} 176 L${c - 19} 128 H${c + 19} L${c + 16.8} 176 Z`}
          />
        </g>
      ))
    }
    <path class="stream" pathLength="1" style="--d: 2850ms" d="M134 64 C131 72 122 74 120 84"></path>
    <path class="stream stream--split" pathLength="1" style="--d: 3250ms" d="M120 84 Q120 98 64 106"></path>
    <path class="stream stream--split" pathLength="1" style="--d: 3250ms" d="M120 84 Q120 98 176 106"></path>
  </g>

  <!-- ACT 3: ½, between the two cups -->
  <g class="act act--3">
    <circle class="ln-solo" pathLength="1" style="--d: 4100ms" cx="120" cy="150" r="21"></circle>
    <path class="ln-solo" pathLength="1" style="--d: 4350ms" d="M112 162 L128 138"></path>
    <text class="num fade" style="--d: 4550ms" x="112" y="149" text-anchor="middle">1</text>
    <text class="num fade" style="--d: 4650ms" x="128.5" y="166" text-anchor="middle">2</text>
  </g>
</svg>
